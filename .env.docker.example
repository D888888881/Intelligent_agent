# Docker Compose 部署模板：复制为 .env 后修改（deploy 脚本会自动复制）
# cp .env.docker.example .env

SECRET_KEY=请替换为长随机串
DEBUG=False

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
PUBLIC_SITE_URL=

DB_NAME=intelligent_agent
DB_USER=postgres
DB_PASSWORD=请替换为强密码
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=5
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

HTTP_PORT=80

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1

GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_API_KEY=
GRSAI_IMAGE_MODEL=nano-banana-2
GRSAI_IMAGE_SIZE=1K
GRSAI_REPLY_TYPE=async
GRSAI_REFERENCE_IMAGE_MODE=url

COS_USE_STORAGE=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_MEDIA_PREFIX=media
COS_PUBLIC_READ=true

GEN_MAX_QUEUE_SIZE=50