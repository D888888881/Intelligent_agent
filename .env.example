OPENAI_API_KEY=sk-vzcf3MNFhMoveatXo88kt74Cspu1CB5ao4Uh4reoulooV2cI

OPENAI_BASE_URL=https://api.openai-proxy.org/v1

OPENAI_CHAT_MODEL=gpt-6.2-sol
OPENAI_VISION_MODEL=gpt-4.1

OPENAI_IMAGE_BACKEND=grsai



GRSAI_BASE_URL=https://grsai.dakka.com.cn

GRSAI_API_KEY=sk-8a6dc9f2e6cf4c43907011d2215e3b52

GRSAI_IMAGE_MODEL=gpt-image-2.5

GRSAI_IMAGE_SIZE=1K

GRSAI_ASPECT_RATIO=1:1

GRSAI_REPLY_TYPE=async

GRSAI_POLL_INTERVAL=5

GRSAI_POLL_TIMEOUT=600
GRSAI_GPT_POLL_TIMEOUT=900
GRSAI_POLL_MAX_SECONDS=1200
GRSAI_PER_IMAGE_MAX_SECONDS=180
GRSAI_PER_IMAGE_LATE_MAX_SECONDS=240
GRSAI_DEFERRED_RECOVERY_WAIT_SECONDS=30
GRSAI_MAX_REF_IMAGES_PER_REQUEST=2
GRSAI_REFERENCE_IMAGE_MODE=auto
# True：除「纯成分镜」外每镜附参考锁 SKU；机位仍由 mandate 拉开角度。False：全部 identity
GEN_SHOT_REF_TIERED=True
# 部署到公网时填写，Grsai 用 URL 拉图，避免巨型 base64（例：https://your-domain.com）
PUBLIC_SITE_URL=

# 腾讯云 COS 对象存储（生产建议开启；本地开发可保持 false 继续写 media/ 目录）
# 控制台创建存储桶后，建议用子账号密钥并仅授予该桶读写权限
COS_USE_STORAGE=false
COS_SECRET_ID=
COS_SECRET_KEY=
# 地域 API 标识，如 ap-guangzhou、ap-shanghai、ap-beijing
COS_REGION=ap-guangzhou
# 桶全名，含 appid 后缀，例如 my-agent-media-1250000000
COS_BUCKET=
# 桶内目录前缀，与原先本地 media/ 对应
COS_MEDIA_PREFIX=media
# 可选：自定义 CDN/加速域名（不含 https://），配置后前端与 Grsai 拉图用该域名
COS_CUSTOM_DOMAIN=
# 可选：覆盖 S3 端点，默认 https://cos.<COS_REGION>.myqcloud.com
# COS_ENDPOINT_URL=
# 公有读桶配 true（Grsai 外网可直接 https 拉图）；私有桶配 false（预签名 URL，需 COS_PUBLIC_READ=false）
COS_PUBLIC_READ=true
# 一般保持 virtual；若签名上传报错再试 path
COS_ADDRESSING_STYLE=virtual
GRSAI_REF_MAX_EDGE=1280
GRSAI_POST_READ_TIMEOUT=180
GRSAI_PER_IMAGE_RETRIES=1
GRSAI_RESULT_DOWNLOAD_RETRIES=4
GRSAI_RESULT_DOWNLOAD_CONNECT=45
GRSAI_RESULT_DOWNLOAD_READ=120
GRSAI_HTTP_RETRIES=3
GRSAI_JOB_FAILED_SHOT_RETRIES=3

GRSAI_GPT_IMAGE_QUALITY=auto
# TK México 第①张场景主图输出边长（像素）；其余镜头仍为 1024×1024
TK_MX_HERO_OUTPUT_SIZE=1280



CELERY_TASK_ALWAYS_EAGER=True
# 不设 eager 时：须启动消费 image 队列的 worker（见 README / scripts/run-celery.ps1）
# 或强制进程内派发：GEN_FORCE_INPROCESS_DISPATCH=True
# Windows 跑 Celery 时用 solo 或 threads，不要用默认 prefork（易 WinError 5）
# CELERY_WORKER_POOL=solo

DJANGO_PORT=8088
CHAT_MESSAGE_INITIAL_PAGE_SIZE=10
CHAT_MESSAGE_PAGE_SIZE=10
CHAT_MESSAGE_PAGE_MAX=50

VITE_DEV_PORT=3000

VITE_DJANGO_PORT=8088

